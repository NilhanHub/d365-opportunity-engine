      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "templateOnly": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "canBlock": {
          "type": "boolean"
        },
        "verifierIds": {
          "$ref": "#/$defs/idArray"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event",
        "handlerType",
        "sourceLocation",
        "blockOnFailure",
        "appliesTo",
        "purpose",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "templateOnly": {
          "type": "boolean"
        },
        "event": {
          "type": "string"
        },
        "handlerType": {
          "type": "string"
        },
        "sourceLocation": {
          "type": "string"
        },
        "blockOnFailure": {
          "type": "boolean"
        },
        "appliesTo": {
          "$ref": "#/$defs/stringArray"
        },
