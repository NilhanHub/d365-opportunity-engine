        "trigger",
        "environmentId",
        "workContextId",
        "boundedTaskContract",
        "verificationRefs",
        "escalationPolicyId",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "templateOnly": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "environmentId": {
          "$ref": "#/$defs/id"
        },
        "workContextId": {
          "$ref": "#/$defs/id"
        },
