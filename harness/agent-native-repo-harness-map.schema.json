{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-native-repo-harness-map:schema:4.0.0",
  "title": "Agent-Native Repo Harness Map",
  "description": "Schema for a layered repo-centered harness map aligned to the Agent-Native Repo Harness Standard dated 2026-04-14.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "manifestKind",
    "manifestVersion",
    "standard",
    "repo",
    "generation",
    "authority",
    "repoKernel",
    "runtimeFabric",
    "specialization",
    "governancePlane",
    "codeGraph",
    "maturity",
    "integrity"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifestKind": {
      "const": "agent-native-repo-harness-map"
    },
    "manifestVersion": {
      "type": "string"
    },
    "template": {
      "type": "boolean"
    },
    "standard": {
      "$ref": "#/$defs/standard"
    },
    "repo": {
      "$ref": "#/$defs/repo"
    },
    "generation": {
      "$ref": "#/$defs/generation"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "repoKernel": {
      "$ref": "#/$defs/repoKernel"
    },
    "runtimeFabric": {
      "$ref": "#/$defs/runtimeFabric"
    },
    "specialization": {
      "$ref": "#/$defs/specialization"
    },
    "governancePlane": {
      "$ref": "#/$defs/governancePlane"
    },
    "codeGraph": {
      "$ref": "#/$defs/codeGraph"
    },
    "maturity": {
      "$ref": "#/$defs/maturity"
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "notes": {
      "type": "string"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "idArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "location": {
      "type": "string"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "date",
        "sourcePath",
        "legacyLineage"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "sourcePath": {
          "type": "string"
        },
        "legacyLineage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replaces",
            "note"
          ],
          "properties": {
            "replaces": {
              "$ref": "#/$defs/stringArray"
            },
            "note": {
              "$ref": "#/$defs/notes"
            }
          }
        }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoId",
        "displayName",
        "repoCondition",
        "repoType",
        "defaultBranch",
        "languages",
        "platforms",
        "notes"
      ],
      "properties": {
        "repoId": {
          "$ref": "#/$defs/id"
        },
        "displayName": {
          "type": "string"
        },
        "repoCondition": {
          "type": "string"
        },
        "repoType": {
          "type": "string"
        },
        "defaultBranch": {
          "type": "string"
        },
        "languages": {
          "$ref": "#/$defs/stringArray"
        },
        "platforms": {
          "$ref": "#/$defs/stringArray"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "frozenToDate",
        "lastGeneratedAt",
        "generatedBy",
        "manualOwners",
        "notes"
      ],
      "properties": {
        "mode": {
          "type": "string"
        },
        "frozenToDate": {
          "type": "string",
          "format": "date"
        },
        "lastGeneratedAt": {
          "type": "string"
        },
        "generatedBy": {
          "$ref": "#/$defs/stringArray"
        },
        "manualOwners": {
          "$ref": "#/$defs/stringArray"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "precedenceLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "scope",
        "location",
        "appliesTo",
        "precedence",
        "mergeBehavior",
        "authoritative",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "templateOnly": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "appliesTo": {
          "type": "string"
        },
        "precedence": {
          "type": "integer"
        },
        "mergeBehavior": {
          "type": "string"
        },
        "authoritative": {
          "type": "boolean"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precedenceModel"
      ],
      "properties": {
        "precedenceModel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "description",
            "layers",
            "defaultColdStartSequence",
            "conflictPolicy",
            "notes"
          ],
          "properties": {
            "description": {
              "type": "string"
            },
            "layers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/precedenceLayer"
              }
            },
            "defaultColdStartSequence": {
              "$ref": "#/$defs/stringArray"
            },
            "conflictPolicy": {
              "type": "string"
            },
            "notes": {
              "$ref": "#/$defs/notes"
            }
          }
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "location",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "templateOnly": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "required": {
          "type": "boolean"
        },
        "freshnessSlaDays": {
          "type": "integer",
          "minimum": 0
        },
        "writePolicy": {
          "type": "string"
        },
        "bounded": {
          "type": "boolean"
        },
        "requiredBeforeExit": {
          "type": "boolean"
        },
        "audience": {
          "type": "string"
        },
        "appendOnly": {
          "type": "boolean"
        }
      }
    },
    "repoKernel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemOfRecordSurfaces",
        "taskSources",
        "handoffArtifacts",
        "exportBoundaries"
      ],
      "properties": {
        "systemOfRecordSurfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surface"
          }
        },
        "taskSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surface"
          }
        },
        "handoffArtifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surface"
          }
        },
        "exportBoundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surface"
          }
        }
      }
    },
    "durableStore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "location",
        "appendOnly"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "templateOnly": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "appendOnly": {
          "type": "boolean"
        }
      }
    },
    "executionEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "setupEntrypoints",
        "cleanupEntrypoints",
        "networkPolicyId",
        "secretPolicyId",
        "writeScope",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "templateOnly": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "setupEntrypoints": {
          "$ref": "#/$defs/stringArray"
        },
        "cleanupEntrypoints": {
          "$ref": "#/$defs/stringArray"
        },
        "networkPolicyId": {
          "$ref": "#/$defs/id"
        },
        "secretPolicyId": {
          "$ref": "#/$defs/id"
        },
        "writeScope": {
          "$ref": "#/$defs/stringArray"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "workContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "location",
        "persistent",
        "isolatedFrom",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "templateOnly": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "persistent": {
          "type": "boolean"
        },
        "isolatedFrom": {
          "$ref": "#/$defs/idArray"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "toolBus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "configLocation",
        "scope",
        "trustClass",
        "supports",
        "approvalBehavior",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "templateOnly": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "configLocation": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "trustClass": {
          "type": "string"
        },
        "supports": {
          "$ref": "#/$defs/stringArray"
        },
        "approvalBehavior": {
          "type": "string"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "runtimeFabric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionContinuity",
        "executionEnvironments",
        "workContexts",
        "toolBuses"
