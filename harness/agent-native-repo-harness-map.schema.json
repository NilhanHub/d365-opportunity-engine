          }
        },
        "reviewLoops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewLoop"
          }
        },
        "hooks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hook"
          }
        },
        "automations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/automation"
          }
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policy"
          }
