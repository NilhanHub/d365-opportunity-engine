      "required": [
        "id",
        "kind",
        "command",
        "workingDirectory",
        "appliesToNodeIds",
        "deterministic",
        "requiredForMerge",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "templateOnly": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "workingDirectory": {
          "type": "string"
