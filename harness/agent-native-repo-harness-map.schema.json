      "properties": {
        "sessionContinuity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "durableStores",
            "checkpointStrategy",
            "compactionStrategy",
            "resumeEntrypoints",
            "notes"
          ],
          "properties": {
            "mode": {
              "type": "string"
            },
            "durableStores": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/durableStore"
              }
            },
            "checkpointStrategy": {
              "type": "string"
            },
            "compactionStrategy": {
              "type": "string"
            },
            "resumeEntrypoints": {
              "$ref": "#/$defs/stringArray"
            },
            "notes": {
              "$ref": "#/$defs/notes"
            }
          }
        },
        "executionEnvironments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionEnvironment"
          }
        },
        "workContexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workContext"
          }
        },
        "toolBuses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolBus"
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "location",
        "scope",
        "invocation",
        "relatedNodeIds",
        "verificationRefs",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "templateOnly": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "invocation": {
          "type": "string"
        },
        "relatedNodeIds": {
          "$ref": "#/$defs/idArray"
        },
        "verificationRefs": {
          "$ref": "#/$defs/idArray"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "definitionLocation",
        "toolScopes",
        "permissionPolicyIds",
        "relatedNodeIds",
        "handoffTargets",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "templateOnly": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "definitionLocation": {
          "type": "string"
        },
        "toolScopes": {
          "$ref": "#/$defs/idArray"
        },
        "permissionPolicyIds": {
          "$ref": "#/$defs/idArray"
        },
        "relatedNodeIds": {
          "$ref": "#/$defs/idArray"
        },
        "handoffTargets": {
          "$ref": "#/$defs/idArray"
        },
        "notes": {
          "$ref": "#/$defs/notes"
        }
      }
    },
    "specialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skills",
        "agents"
      ],
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skill"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          }
        }
      }
    },
    "verificationSurface": {
      "type": "object",
