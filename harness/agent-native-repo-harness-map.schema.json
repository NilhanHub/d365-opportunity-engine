    },
    "publicSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contracts",
        "apiFiles",
        "schemaFiles"
      ],
      "properties": {
        "contracts": {
          "$ref": "#/$defs/stringArray"
