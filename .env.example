D365_OPPS_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/d365opps
D365_OPPS_BLOB_ROOT=./var/blob
D365_OPPS_EXPORT_ROOT=./var/exports
D365_OPPS_HTTP_TIMEOUT_SECONDS=30
D365_OPPS_FETCH_WINDOW_DAYS=1
D365_OPPS_USER_AGENT=d365-opportunity-engine/0.1 (+https://example.com)
# Intentionally empty public configuration template.
D365_OPPS_SAM_GOV_API_KEY="" # gitleaks:allow
D365_OPPS_SEARCH_API_ENDPOINT=
# Intentionally empty public configuration template.
D365_OPPS_SEARCH_API_KEY="" # gitleaks:allow
D365_OPPS_GLEIF_ENABLED=true
D365_OPPS_RETRIEVAL_MIN_SCORE=40
D365_OPPS_SIGNAL_MIN_SCORE=22
D365_OPPS_ATTACHMENT_FETCH_ENABLED=true
D365_OPPS_MAX_ATTACHMENT_FETCH_PER_RECORD=2
D365_OPPS_MAX_ATTACHMENT_BYTES=5242880
D365_OPPS_SOURCE_DISCOVERY_LIMIT=100
